# PathForge AI — Environment Variables
# ─────────────────────────────────────
# LOCAL DEVELOPMENT (leave VITE_API_BASE_URL empty → app uses mock AI)
VITE_API_BASE_URL=

# PRODUCTION (set this to your API Gateway invoke URL after deploying Lambdas)
# Example: VITE_API_BASE_URL=https://abc123xyz.execute-api.us-east-1.amazonaws.com/prod
# Set this in: AWS Amplify Console → App Settings → Environment Variables
